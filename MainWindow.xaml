<Window x:Class="SqlTransactionMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SqlTransactionMonitor"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="SQL Transaction Monitor"
        Height="820"
        Width="1220"
        MinHeight="650"
        MinWidth="950">



    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="#CCD3DA" BorderThickness="1" CornerRadius="6" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="4"><TextBlock Text="SQL Server" FontWeight="SemiBold"/><TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="4"><TextBlock Text="Database" FontWeight="SemiBold"/><TextBox Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                
                
                <StackPanel Grid.Column="2" Margin="4"><TextBlock Text="User name" FontWeight="SemiBold"/>

                    <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="IsEnabled" Value="True"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseWindowsAuthentication}"
                             Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                </StackPanel>
                
                
                <StackPanel Grid.Column="3" Margin="4"><TextBlock Text="Password" FontWeight="SemiBold"/>

                    <PasswordBox PasswordChanged="PasswordBox_OnPasswordChanged">
                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox">
                                <Setter Property="IsEnabled" Value="True"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseWindowsAuthentication}"
                             Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>
                    </PasswordBox>
                    
                </StackPanel>
               
                
                
                <StackPanel Grid.Column="4" Margin="10,0,4,0" VerticalAlignment="Bottom">
                    <CheckBox Content="Windows authentication" IsChecked="{Binding UseWindowsAuthentication}" Margin="0,0,0,8"/>
                    <Button Content="Connect" Command="{Binding ConnectCommand}" Width="120" Padding="8,4"/>
                </StackPanel>
            </Grid>
        </Border>
        <DockPanel Grid.Row="1" Margin="0,10,0,8">
            <StackPanel Orientation="Horizontal"
            DockPanel.Dock="Left">

                <Button Content="{Binding MonitorButtonText}"
            Command="{Binding ToggleMonitoringCommand}"
            Padding="14,6"
            Margin="0,0,8,0"/>

                <Button Content="Export CSV"
            Command="{Binding ExportCsvCommand}"
            Padding="14,6"
            Margin="0,0,8,0"/>

                <Button Content="Clear Database Data"
            Command="{Binding ClearDatabaseDataCommand}"
            Padding="14,6"
            Margin="0,0,8,0"
            Foreground="DarkRed"/>

            </StackPanel>

            <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentTransactionsPerMinute, StringFormat=Current: {0:N1} transactions/min}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </DockPanel>
        <lvc:CartesianChart Grid.Row="2" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" LegendPosition="Top" ZoomMode="X"/>
        
        <DataGrid Grid.Row="3" ItemsSource="{Binding Samples}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,8,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Local time" Binding="{Binding TimestampLocal, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="2*"/>
                <DataGridTextColumn Header="Transactions/min" Binding="{Binding TransactionsPerMinute, StringFormat=N2}" Width="*"/>
                <DataGridTextColumn Header="SQL counter value" Binding="{Binding CounterValue, StringFormat=N0}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>


        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"
                   TextWrapping="Wrap"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <TextBlock Text="{Binding DatabasePath,
                                  StringFormat=SQLite: {0}}"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <Button Content="Open Logs"
                Command="{Binding OpenLogFolderCommand}"
                Padding="8,2"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
